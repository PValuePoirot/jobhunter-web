# Copy to .env.local (local dev) and add the same two values in Vercel → Project → Settings → Environment Variables.
# Both are safe to expose in the browser: data is protected by Supabase row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
